{
  "name": "guruji",
  "version": "0.1.0",
  "private": true,
  "description": "GuruJi — an intelligent personal DSA training system.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "dev:web": "pnpm --filter @guruji/web dev",
    "dev:api": "pnpm --filter @guruji/api dev",
    "build": "pnpm --filter \"./packages/**\" build && pnpm --filter \"./apps/**\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "db:generate": "pnpm --filter @guruji/database generate",
    "db:migrate": "pnpm --filter @guruji/database migrate",
    "db:seed": "pnpm --filter @guruji/database seed",
    "db:studio": "pnpm --filter @guruji/database studio",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "@guruji/config": "workspace:*"
  }
}
