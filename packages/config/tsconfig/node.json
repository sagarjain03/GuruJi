{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* NestJS and the code runner: CommonJS + decorator metadata. */
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
    // No rootDir/outDir here: a relative path in a shared preset resolves
    // against the preset's own folder, not the package that extends it.
  }
}
