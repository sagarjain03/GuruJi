{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "react-jsx",
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    /* Next compiles with SWC; verbatim import syntax fights the next plugin. */
    "verbatimModuleSyntax": false,
    "plugins": [{ "name": "next" }]
  }
}
