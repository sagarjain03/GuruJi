{
  "name": "@guruji/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev && prisma generate && tsc -b",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@guruji/config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "prisma": "7.10.0",
    "prisma-erd-generator": "^3.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
