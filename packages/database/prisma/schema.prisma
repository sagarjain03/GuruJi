// GuruJi — identity schema (Phase 1).
// Conventions are fixed in docs/database.md: uuid keys, snake_case SQL,
// camelCase Prisma fields, TIMESTAMPTZ everywhere, explicit onDelete.

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

// Entity-relationship diagram, regenerated on every `prisma generate`.
// Mermaid output renders in GitHub and in VS Code's markdown preview.
generator erd {
  provider = "prisma-erd-generator"
  output   = "../../../docs/erd.md"
  theme    = "neutral"
}

// Prisma 7 keeps the connection URL out of the schema: Migrate reads it from
// prisma.config.ts, the client gets it through a driver adapter.
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum Language {
  CPP
  C
  PYTHON
  JAVASCRIPT

  @@map("language")
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("experience_level")
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  // Stored lowercase; normalisation happens in the auth service so the unique
  // index is enough and no Postgres extension is required.
  email String @unique @db.VarChar(320)

  // Argon2id. Never selected into a DTO — repositories return explicit fields.
  passwordHash String @map("password_hash")

  role            Role      @default(USER)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  profile       Profile?
  refreshTokens RefreshToken[]
  drafts        Draft[]
  submissions   Submission[]

  topicProgress   UserTopicProgress[]
  patternProgress UserPatternProgress[]
  mistakes        Mistake[]
  studySessions   StudySession[]
  revisionItems   RevisionItem[]

  @@map("users")
}

model Profile {
  userId String @id @map("user_id") @db.Uuid

  displayName       String          @map("display_name") @db.VarChar(80)
  preferredLanguage Language        @default(CPP) @map("preferred_language")
  experienceLevel   ExperienceLevel @default(BEGINNER) @map("experience_level")
  dailyGoalMinutes  Int             @default(30) @map("daily_goal_minutes")

  // Denormalised on purpose: read on every dashboard load, recomputed on submission.
  difficultyTolerance Float @default(0.5) @map("difficulty_tolerance")
  hintDependency      Float @default(0) @map("hint_dependency")
  retentionScore      Float @default(0) @map("retention_score")

  currentStreak Int       @default(0) @map("current_streak")
  longestStreak Int       @default(0) @map("longest_streak")
  // A local-day concept, not an instant — hence `date`, resolved against `timezone`.
  lastActiveDate DateTime? @map("last_active_date") @db.Date

  // IANA name, e.g. "Asia/Kolkata". A preference, never stored beside a timestamp.
  timezone String @default("UTC") @db.VarChar(64)

  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Hashed, never plaintext. Unique so a replay is a lookup, not a scan.
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  // Set on rotation. Presenting a token that has one means the old token was
  // replayed — the whole chain is revoked.
  replacedById String? @unique @map("replaced_by_id") @db.Uuid

  userAgent String? @map("user_agent") @db.VarChar(512)
  ipHash    String? @map("ip_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  // Query: revoke or list every token for one user (chain revocation, logout-all).
  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Content (Phase 2). Conventions unchanged: uuid keys, snake_case SQL,
// camelCase Prisma fields, TIMESTAMPTZ, explicit onDelete on every relation.
// ---------------------------------------------------------------------------

enum Difficulty {
  EASY
  MEDIUM
  HARD

  @@map("difficulty")
}

enum ProblemSource {
  ORIGINAL
  LICENSED
  EXTERNAL_REFERENCE
  AI_GENERATED

  @@map("problem_source")
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED

  @@map("review_status")
}

enum RoadmapSection {
  FOUNDATION
  DATA_STRUCTURES
  TREES
  GRAPHS
  ADVANCED

  @@map("roadmap_section")
}

// Whether a tag is what the problem is *about* or merely something it touches.
// The recommendation engine weights PRIMARY far more heavily.
enum TagRelevance {
  PRIMARY
  SECONDARY

  @@map("tag_relevance")
}

/// A subject area — Arrays, Graphs, Dynamic Programming.
model Topic {
  id          String  @id @default(uuid(7)) @db.Uuid
  slug        String  @unique @db.VarChar(80)
  name        String  @db.VarChar(120)
  description String
  // Curriculum order within the roadmap section. Data, not a deploy.
  displayOrder Int    @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roadmapNodes RoadmapNode[]
  problems     ProblemTopic[]

  // Prerequisites are a join table rather than a uuid[] column: an array cannot
  // carry a foreign key, so a deleted topic would leave dangling ids behind and
  // the roadmap would render edges to nothing.
  prerequisites  TopicPrerequisite[] @relation("TopicDependent")
  requiredBy     TopicPrerequisite[] @relation("TopicPrerequisite")

  userProgress UserTopicProgress[]

  @@map("topics")
}

/// "Topic `topicId` cannot be started before `prerequisiteId`."
model TopicPrerequisite {
  topicId        String @map("topic_id") @db.Uuid
  prerequisiteId String @map("prerequisite_id") @db.Uuid

  topic        Topic @relation("TopicDependent", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite Topic @relation("TopicPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("topic_prerequisites")
}

/// A reusable solving technique — Sliding Window, Two Pointer, Binary Search on
/// Answer. Deliberately separate from Topic: "bad at Graphs" and "bad at BFS"
/// are different diagnoses.
model Pattern {
  id           String @id @default(uuid(7)) @db.Uuid
  slug         String @unique @db.VarChar(80)
  name         String @db.VarChar(120)
  description  String
  displayOrder Int    @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  problems     ProblemPattern[]
  userProgress UserPatternProgress[]

  @@map("patterns")
}

/// The roadmap tree. It lives here so changing the curriculum is a data change.
model RoadmapNode {
  id       String  @id @default(uuid(7)) @db.Uuid
  topicId  String  @map("topic_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid

  section        RoadmapSection
  displayOrder   Int            @map("display_order")
  estimatedHours Int            @map("estimated_hours")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a parent node must not silently delete the
  // subtree under it. Re-parent first, then delete.
  parent   RoadmapNode?  @relation("RoadmapTree", fields: [parentId], references: [id], onDelete: Restrict)
  children RoadmapNode[] @relation("RoadmapTree")

  // One node per topic — the tree is a curriculum, not a tag cloud.
  @@unique([topicId])
  @@index([parentId])
  @@map("roadmap_nodes")
}

model Problem {
  id    String @id @default(uuid(7)) @db.Uuid
  slug  String @unique @db.VarChar(120)
  title String @db.VarChar(200)

  difficulty  Difficulty
  statement   String
  constraints String

  // [{ input, output, explanation }] — display-only, not graded.
  examples Json
  // { cpp, c, python, javascript }
  starterCode Json @map("starter_code")

  timeLimitMs      Int @map("time_limit_ms")
  memoryLimitMb    Int @map("memory_limit_mb")
  estimatedMinutes Int @map("estimated_minutes")

  source       ProblemSource @default(ORIGINAL)
  sourceUrl    String?       @map("source_url") @db.VarChar(500)
  aiGenerated  Boolean       @default(false) @map("ai_generated")
  reviewStatus ReviewStatus  @default(DRAFT) @map("review_status")

  // Denormalised, recomputed periodically. Null until anyone has submitted.
  acceptanceRate Float? @map("acceptance_rate")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  topics    ProblemTopic[]
  patterns  ProblemPattern[]
  testCases   TestCase[]
  hints       Hint[]
  drafts        Draft[]
  submissions   Submission[]
  mistakes      Mistake[]
  revisionItems RevisionItem[]

  // The filtered problem list.
  @@index([difficulty, reviewStatus])
  // Cursor pagination orders by (createdAt desc, id desc).
  @@index([createdAt, id])
  @@map("problems")
}

model ProblemTopic {
  problemId String       @map("problem_id") @db.Uuid
  topicId   String       @map("topic_id") @db.Uuid
  relevance TagRelevance @default(SECONDARY)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([problemId, topicId])
  // Candidate generation by topic.
  @@index([topicId, problemId])
  @@map("problem_topics")
}

model ProblemPattern {
  problemId String       @map("problem_id") @db.Uuid
  patternId String       @map("pattern_id") @db.Uuid
  relevance TagRelevance @default(SECONDARY)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@id([problemId, patternId])
  @@index([patternId, problemId])
  @@map("problem_patterns")
}

model TestCase {
  id        String @id @default(uuid(7)) @db.Uuid
  problemId String @map("problem_id") @db.Uuid

  input          String
  expectedOutput String @map("expected_output")

  // isSample is what the client may see; isHidden is what grading uses. They are
  // not inverses — a case can be neither (visible in the editor, ungraded).
  isSample     Boolean @default(false) @map("is_sample")
  isHidden     Boolean @default(true) @map("is_hidden")
  displayOrder Int     @map("display_order")
  weight       Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  problem Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  results SubmissionResult[]

  @@unique([problemId, displayOrder])
  @@index([problemId, isSample])
  @@map("test_cases")
}

model Hint {
  id        String @id @default(uuid(7)) @db.Uuid
  problemId String @map("problem_id") @db.Uuid

  // 1..n, served one level at a time. Curated hints are asked before the model.
  level   Int
  content String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, level])
  @@map("hints")
}

// ---------------------------------------------------------------------------
// Editor (Phase 3).
// ---------------------------------------------------------------------------

/// Unsubmitted code, kept so a reload never costs anyone their work.
model Draft {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  problemId String @map("problem_id") @db.Uuid

  // One draft per language, not one per problem. Switching from C++ to Python
  // to check an idea must not overwrite the C++ attempt.
  language Language
  code     String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  // The upsert target for every autosave.
  @@unique([userId, problemId, language])
  // "What was I last working on" — read by the dashboard from Phase 5.
  @@index([userId, updatedAt])
  @@map("drafts")
}

// ---------------------------------------------------------------------------
// Execution (Phase 4). See docs/code-execution.md.
// ---------------------------------------------------------------------------

/// The lifecycle of *our* job, not the judgement of the code.
enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED

  @@map("submission_status")
}

/// The judgement of the code. Separate from status on purpose: a FAILED status
/// with no verdict means our infrastructure broke, and that must never be
/// recorded as the user getting the problem wrong.
enum Verdict {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILE_ERROR
  INTERNAL_ERROR

  @@map("verdict")
}

model Submission {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  problemId String @map("problem_id") @db.Uuid

  language Language
  // Its own copy, never a pointer at the draft: editing the draft afterwards
  // must not rewrite the history of what was actually judged.
  code     String

  status  SubmissionStatus @default(QUEUED)
  verdict Verdict?

  runtimeMs Int? @map("runtime_ms")
  memoryKb  Int? @map("memory_kb")

  passedCount Int @default(0) @map("passed_count")
  totalCount  Int @default(0) @map("total_count")

  compileOutput String? @map("compile_output")

  /// true = "Run" against samples. Kept out of the mastery signal in Phase 5:
  /// counting exploratory runs would punish people for testing their thinking.
  isRun Boolean @default(false) @map("is_run")

  hintsUsedAtSubmit Int @default(0) @map("hints_used_at_submit")
  timeSpentMs       Int @default(0) @map("time_spent_ms")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem  Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  results  SubmissionResult[]
  mistakes Mistake[]

  // Submission history and the activity chart.
  @@index([userId, createdAt])
  // Per-problem attempt history.
  @@index([userId, problemId, createdAt])
  // Acceptance-rate recomputation.
  @@index([problemId, verdict])
  @@map("submissions")
}

model SubmissionResult {
  id           String @id @default(uuid(7)) @db.Uuid
  submissionId String @map("submission_id") @db.Uuid
  testCaseId   String @map("test_case_id") @db.Uuid

  passed    Boolean
  runtimeMs Int? @map("runtime_ms")
  memoryKb  Int? @map("memory_kb")

  /// Capped at write time. An unbounded column here is a storage-denial vector:
  /// a program that prints a gigabyte would otherwise land in the database.
  actualOutput String? @map("actual_output")
  errorMessage String? @map("error_message")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([submissionId, testCaseId])
  @@index([testCaseId])
  @@map("submission_results")
}

// ---------------------------------------------------------------------------
// Progress (Phase 5). See docs/mastery-model.md.
// ---------------------------------------------------------------------------

/// The counters a mastery score is computed from.
///
/// Materialised, not computed on read. The dashboard draws a bar per topic on
/// every load, and recomputing that from full submission history is fine at ten
/// submissions and unusable at ten thousand.
///
/// Updated inside the submission-completion transaction, so they cannot drift
/// from a write that succeeded. They can still drift from a write path that
/// bypasses the transaction, which is what the nightly reconciliation job
/// exists to *report* — it logs the discrepancy rather than correcting it,
/// because a drift is a bug somewhere and silently fixing it hides the bug.
model UserTopicProgress {
  id      String @id @default(uuid(7)) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  topicId String @map("topic_id") @db.Uuid

  /// Distinct problems attempted, not submissions. Retrying is not evidence.
  attempts           Int @default(0)
  solved             Int @default(0)
  /// Solved on the first graded submission — the honest accuracy signal.
  firstAttemptSolved Int @default(0) @map("first_attempt_solved")

  /// Phase 6 fills these. Until then retention is *unmeasured*, not zero.
  revisionAttempts  Int @default(0) @map("revision_attempts")
  revisionSuccesses Int @default(0) @map("revision_successes")

  easyAttempts   Int @default(0) @map("easy_attempts")
  easySolved     Int @default(0) @map("easy_solved")
  mediumAttempts Int @default(0) @map("medium_attempts")
  mediumSolved   Int @default(0) @map("medium_solved")
  hardAttempts   Int @default(0) @map("hard_attempts")
  hardSolved     Int @default(0) @map("hard_solved")

  /// Distinct patterns this user has solved within the topic.
  patternsSolved Int @default(0) @map("patterns_solved")

  /// Sum of per-problem clamped speed ratios, and the sample count behind it.
  /// A sum of ratios rather than of times: one session left open overnight
  /// would otherwise sink the component permanently.
  speedRatioSum Float @default(0) @map("speed_ratio_sum")
  speedSamples  Int   @default(0) @map("speed_samples")

  /// Weighted by the hint level reached, not a plain count.
  hintWeightedSolves Float @default(0) @map("hint_weighted_solves")

  /// Derived from the counters above and stored so the dashboard can read it.
  masteryScore   Float     @default(0) @map("mastery_score")
  lastPracticedAt DateTime? @map("last_practiced_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// The upsert target for every submission.
  @@unique([userId, topicId])
  /// Weak-topic ranking, read by the recommendation engine in Phase 7.
  @@index([userId, masteryScore])
  @@map("user_topic_progress")
}

/// The same counters per pattern.
///
/// Kept separate from the topic table rather than collapsed into one score,
/// because the two answer different questions. Low topic mastery with healthy
/// pattern mastery means the data structure is the gap; the reverse means the
/// technique is. Collapsing them loses exactly the distinction that makes a
/// recommendation useful.
model UserPatternProgress {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  patternId String @map("pattern_id") @db.Uuid

  attempts           Int @default(0)
  solved             Int @default(0)
  firstAttemptSolved Int @default(0) @map("first_attempt_solved")

  revisionAttempts  Int @default(0) @map("revision_attempts")
  revisionSuccesses Int @default(0) @map("revision_successes")

  easyAttempts   Int @default(0) @map("easy_attempts")
  easySolved     Int @default(0) @map("easy_solved")
  mediumAttempts Int @default(0) @map("medium_attempts")
  mediumSolved   Int @default(0) @map("medium_solved")
  hardAttempts   Int @default(0) @map("hard_attempts")
  hardSolved     Int @default(0) @map("hard_solved")

  speedRatioSum Float @default(0) @map("speed_ratio_sum")
  speedSamples  Int   @default(0) @map("speed_samples")

  hintWeightedSolves Float @default(0) @map("hint_weighted_solves")

  masteryScore    Float     @default(0) @map("mastery_score")
  lastPracticedAt DateTime? @map("last_practiced_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([userId, patternId])
  @@index([userId, masteryScore])
  @@map("user_pattern_progress")
}

/// A closed set on purpose.
///
/// The value of the mistake journal is aggregation — "you have made this
/// mistake in three sliding-window problems" only works if the categories
/// cannot be free text.
enum MistakeCategory {
  LOGIC
  SYNTAX
  EDGE_CASE
  COMPLEXITY
  IMPLEMENTATION
  MISREAD_PROBLEM
  WRONG_PATTERN
  OFF_BY_ONE
  OVERFLOW

  @@map("mistake_category")
}

model Mistake {
  id           String  @id @default(uuid(7)) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  problemId    String  @map("problem_id") @db.Uuid
  /// Nullable: a mistake can be logged from reflection, not only from a verdict.
  submissionId String? @map("submission_id") @db.Uuid

  category      MistakeCategory
  whatWentWrong String          @map("what_went_wrong")
  correctIdea   String?         @map("correct_idea")
  /// Filled by the mentor in Phase 8. Never overwrites what the user wrote.
  aiAnalysis    String?         @map("ai_analysis")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem    Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  /// Mistake aggregation — the journal's whole reason to exist.
  @@index([userId, category, createdAt])
  @@index([userId, createdAt])
  @@map("mistakes")
}

enum StudySessionSource {
  PRACTICE
  REVISION
  CONTEST
  ASSESSMENT

  @@map("study_session_source")
}

/// Feeds daily goals and the activity heatmap.
model StudySession {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  startedAt DateTime  @map("started_at") @db.Timestamptz(3)
  /// Null while a session is open. Closed by the next one, or by a sweep.
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  problemsAttempted Int @default(0) @map("problems_attempted")
  problemsSolved    Int @default(0) @map("problems_solved")

  source StudySessionSource @default(PRACTICE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The activity heatmap, and "is a session already open".
  @@index([userId, startedAt])
  @@map("study_sessions")
}

// ---------------------------------------------------------------------------
// Revision (Phase 6). See docs/revision-engine.md.
// ---------------------------------------------------------------------------

/// How a revision went, as the user reports it.
///
/// Graded on *how* the answer was reconstructed, not just whether it was. A
/// problem solved after twenty minutes of flailing is not the same evidence as
/// one solved in three, and a schedule that treats them alike will bring the
/// second one back far too late.
enum RevisionOutcome {
  SOLVED_EASILY
  SOLVED_WITH_EFFORT
  STRUGGLED
  FAILED

  @@map("revision_outcome")
}

enum RevisionState {
  LEARNING
  REVIEWING
  MASTERED
  /// Failed after having reached REVIEWING. Prioritised above a fresh problem:
  /// knowledge you had and lost is the cheapest thing to recover.
  LAPSED

  @@map("revision_state")
}

model RevisionItem {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  problemId String @map("problem_id") @db.Uuid

  /// Days until the next review. The ladder is 1, 3, 7, 14, 30, 60, 120 at the
  /// default ease; the ease factor stretches or compresses it per user.
  intervalDays Int   @default(1) @map("interval_days")
  /// 1.3 to 3.0. The floor matters most — without it a repeatedly-failed
  /// problem collapses into a permanent daily item and people stop opening the app.
  ease         Float @default(2.5)
  /// Position on the ladder. Advances on a success, holds on a struggle.
  ladderIndex  Int   @default(0) @map("ladder_index")

  repetitions Int @default(0)
  lapses      Int @default(0)
  /// Non-struggling successes in a row. MASTERED needs three, not one.
  streak      Int @default(0)

  state RevisionState @default(LEARNING)

  /// TIMESTAMPTZ. "Due today" is a *local-day* question answered against the
  /// user's IANA timezone at query time — never by storing a local date.
  dueAt          DateTime  @map("due_at") @db.Timestamptz(3)
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  reviews RevisionReview[]

  /// One schedule per problem per user — the upsert target.
  @@unique([userId, problemId])
  /// The hottest query in the product: "what is due for me right now".
  @@index([userId, dueAt])
  /// Queue ordering puts LAPSED first.
  @@index([userId, state, dueAt])
  @@map("revision_items")
}

/// One completed review. Kept as history rather than folded into the item,
/// because `retention` in the mastery model is a rate over attempts and a
/// counter that only ever moves forward cannot be recomputed from source.
model RevisionReview {
  id             String @id @default(uuid(7)) @db.Uuid
  revisionItemId String @map("revision_item_id") @db.Uuid
  /// Null when the outcome was reported without a graded submission behind it.
  submissionId   String? @map("submission_id") @db.Uuid

  outcome RevisionOutcome
  /// The interval that was in effect when this review came due, for auditing
  /// the schedule after the fact.
  intervalDays Int @map("interval_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item RevisionItem @relation(fields: [revisionItemId], references: [id], onDelete: Cascade)

  @@index([revisionItemId, createdAt])
  @@map("revision_reviews")
}
