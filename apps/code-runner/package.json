{
  "name": "@guruji/code-runner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:adversarial": "vitest run test/adversarial.spec.ts",
    "images:build": "node scripts/build-images.mjs"
  },
  "dependencies": {
    "@guruji/types": "workspace:*",
    "bullmq": "^5.65.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@guruji/config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
