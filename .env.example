# =============================================================================
# GuruJi — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Core ------------------------------------------------------------------
NODE_ENV=development
TZ=UTC

# --- Database (PostgreSQL) --------------------------------------------------
POSTGRES_USER=guruji
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=guruji
POSTGRES_PORT=5432
DATABASE_URL="postgresql://guruji:change_me_locally@localhost:5432/guruji?schema=public"

# --- Redis (cache + BullMQ queues) -----------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- API (NestJS) -----------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
API_GLOBAL_PREFIX=api
CORS_ORIGINS="http://localhost:3000"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# --- Web (Next.js) ----------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME="GuruJi"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# --- AI (Groq) --------------------------------------------------------------
# Get a key at https://console.groq.com — this is a server-only secret.
# It must NEVER be prefixed with NEXT_PUBLIC_.
GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL_FAST=llama-3.1-8b-instant
AI_MODEL_QUALITY=llama-3.3-70b-versatile
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_REQUESTS_PER_MINUTE=20

# --- Code runner ------------------------------------------------------------
CODE_RUNNER_URL="http://localhost:4100"
CODE_RUNNER_SHARED_SECRET=replace_me_with_a_long_random_string
CODE_RUNNER_MAX_CONCURRENCY=4
CODE_RUNNER_TIMEOUT_MS=5000
CODE_RUNNER_MEMORY_MB=256
CODE_RUNNER_MAX_OUTPUT_BYTES=65536
CODE_RUNNER_PIDS_LIMIT=64

# --- Observability ----------------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=
