# =============================================================================
# GuruJi — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Core ------------------------------------------------------------------
NODE_ENV=development
TZ=UTC

# --- Database (PostgreSQL) --------------------------------------------------
POSTGRES_USER=guruji
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=guruji
POSTGRES_PORT=5432
DATABASE_URL="postgresql://guruji:change_me_locally@localhost:5432/guruji?schema=public"

# --- Redis (cache + BullMQ queues) -----------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- API (NestJS) -----------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
API_GLOBAL_PREFIX=api
CORS_ORIGINS="http://localhost:3000"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# --- Web (Next.js) ----------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME="GuruJi"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# --- AI (Groq) --------------------------------------------------------------
# Get a key at https://console.groq.com — this is a server-only secret.
# It must NEVER be prefixed with NEXT_PUBLIC_.
GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL_FAST=llama-3.1-8b-instant
AI_MODEL_QUALITY=llama-3.3-70b-versatile
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_REQUESTS_PER_MINUTE=20

# --- Code runner ------------------------------------------------------------
# The runner has no ingress of its own — it is a queue worker, not a service
# with an address. This is the internal address it posts results *back* to.
API_INTERNAL_URL="http://localhost:4000"
CODE_RUNNER_SHARED_SECRET=replace_me_with_a_long_random_string
CODE_RUNNER_MAX_CONCURRENCY=4
CODE_RUNNER_TIMEOUT_MS=5000
CODE_RUNNER_MEMORY_MB=256
COMPILE_TIMEOUT_MS=20000
# Container startup is our cost, not the submitter's, so the program's clock is
# armed when the container is observed running. These two only control how often
# we look, and how long we wait for a container that never starts at all.
SANDBOX_START_POLL_MS=200
SANDBOX_STARTUP_CEILING_MS=120000
SANDBOX_IMAGE_PREFIX=guruji-sandbox
SANDBOX_IMAGE_TAG=1

# --- Observability ----------------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=
